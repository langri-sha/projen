"""
Smoke tests for the packages a workspace publishes: each is packed, installed
into a project of its own and run under plain Node, which tools such as tsx
would otherwise paper over. The API references they commit are rebuilt and
compared.
"""
type Smoke {
  """
  The workspace with its dependencies installed, from the typescript module.
  """
  pub installed: Container!

  new(
    ws: Workspace!,
    baseImageAddress: String! = "node:24-slim",
  ) {
    self.installed = typescript(ws: ws, baseImageAddress: baseImageAddress).base
    self
  }

  """
  The packages built as the typescript module's `publishable` check builds
  them, with the same command, so that Dagger reuses its build.
  """
  let built: Container! {
    installed.withExec([
      "pnpm",
      "-r",
      "--if-present",
      "--include-workspace-root",
      "run",
      "prepublishOnly",
    ])
  }

  """
  Run each package's `smoke.mjs` against its tarball.
  """
  pub smoke: Void @check {
    built
      .withMountedCache("/root/.npm", cacheVolume("npm-cache"))
      .withFile("/run/smoke.mjs", currentModule.source.file("run.mjs"))
      .withExec(["node", "/run/smoke.mjs"])
      .sync

    null
  }

  """
  Fail when a committed `API.md` differs from the one the build writes.
  """
  pub apiDocs: Void @check {
    built
      .withMountedDirectory("/committed", installed.directory("/src"))
      .withExec([
        "sh",
        "-c",
        "status=0; for file in $(find packages -name API.md -not -path '*/node_modules/*'); do diff -u /committed/$file $file || { echo $file is stale: run pnpm --dir $(dirname $file) run prepublishOnly and commit $file >&2; status=1; }; done; exit $status",
      ])
      .sync

    null
  }

  """
  Write the `API.md` of every package from the build the `apiDocs` check
  compares, so that a generator and its check cannot disagree.
  """
  pub generateApiDocs: Changeset! @generate {
    built
      .directory("/src")
      .filter(include: ["packages/**/API.md"], exclude: ["**/node_modules"])
      .changes(
        installed
          .directory("/src")
          .filter(include: ["packages/**/API.md"], exclude: ["**/node_modules"]),
      )
  }
}
