"""
Smoke tests for the packages a workspace publishes: each is packed, installed
into a project of its own and run under plain Node, which tools such as tsx
would otherwise paper over. The API references they commit are rebuilt and
compared, and so is each package's API with its release's.
"""
type Smoke {
  """
  The workspace with its dependencies installed, from the typescript module.
  """
  pub installed: Container!

  new(
    ws: Workspace!,
    baseImageAddress: String! = "node:24-slim",
  ) {
    self.installed = typescript(ws: ws, baseImageAddress: baseImageAddress).base
    self
  }

  """
  The packages built as the typescript module's `publishable` check builds
  them, with the same command, so that Dagger reuses its build.
  """
  let built: Container! {
    installed.withExec([
      "pnpm",
      "-r",
      "--if-present",
      "--include-workspace-root",
      "run",
      "prepublishOnly",
    ])
  }

  """
  Run each package's `smoke.mjs` against its tarball.
  """
  pub smoke: Void @check {
    built
      .withMountedCache("/root/.npm", cacheVolume("npm-cache"))
      .withFile("/run/smoke.mjs", currentModule.source.file("run.mjs"))
      .withExec(["node", "/run/smoke.mjs"])
      .sync

    null
  }

  """
  Fail when a committed `API.md` differs from the one the build writes.
  """
  pub apiDocs: Void @check {
    built
      .withMountedDirectory("/committed", installed.directory("/src"))
      .withExec([
        "sh",
        "-c",
        "status=0; for file in $(find packages -name API.md -not -path '*/node_modules/*'); do diff -u /committed/$file $file || { echo $file is stale: run dagger generate smoke/generate-api-docs, or pnpm --dir $(dirname $file) run prepublishOnly, and commit $file >&2; status=1; }; done; exit $status",
      ])
      .sync

    null
  }

  """
  Fail when a package's API breaks against the version it last released and
  no pending change file releases the break.
  """
  pub apiBreaks: Void @check {
    built
      .withMountedCache("/root/.npm", cacheVolume("npm-cache"))
      .withFile("/run/api-diff.mjs", currentModule.source.file("api-diff.mjs"))
      .withExec(["node", "/run/api-diff.mjs"])
      .sync

    null
  }

  """
  Write the `API.md` of every package from the build the `apiDocs` check
  compares, so that a generator and its check cannot disagree.
  """
  pub generateApiDocs: Changeset! @generate {
    built
      .directory("/src")
      .filter(include: ["packages/**/API.md"], exclude: ["**/node_modules"])
      .changes(
        installed
          .directory("/src")
          .filter(include: ["packages/**/API.md"], exclude: ["**/node_modules"]),
      )
  }

  """
  Regenerate the types the packages derive from their JSON schemas, with the
  root `schemas` task, which reads the live schemas. It is not a workspace
  generator, so that a schema that moved stays out of unrelated pull requests.
  """
  pub generateSchemas: Changeset! @generate @cache(policy: FunctionCachePolicy.Never) {
    installed
      .withEnvVariable("CACHEBUST", UUID.v7)
      .withExec(["pnpm", "schemas"])
      .directory("/src")
      .filter(include: ["packages/*/src/*.ts"], exclude: ["**/node_modules"])
      .changes(
        installed
          .directory("/src")
          .filter(include: ["packages/*/src/*.ts"], exclude: ["**/node_modules"]),
      )
  }

  """
  Regenerate the schema types, and when one moved, push them with their change
  files to a bot-owned branch and open a pull request. Only the container that
  pushes holds the token; the ones that read the schemas and the repository
  never do. `sha` is the commit the schemas were generated from. `remote` and
  `pullRequest` let a test run against a local repository.
  """
  pub refreshSchemas(
    token: Secret!,
    appSlug: String!,
    repository: String!,
    branch: String! = "schema-refresh",
    base: String! = "main",
    botId: String! = "",
    sha: String! = "",
    remote: String! = "",
    pullRequest: Boolean! = true,
  ): String! @cache(policy: FunctionCachePolicy.Never) {
    let git = container
      .from("alpine:3.22")
      .withExec(["apk", "add", "--no-cache", "bash", "curl", "git", "github-cli", "jq"])
      .withEnvVariable("CACHEBUST", UUID.v7)
      .withEnvVariable("APP_SLUG", appSlug)
      .withEnvVariable("REPOSITORY", repository)
      .withEnvVariable("BRANCH", branch)
      .withEnvVariable("BASE", base)
      .withEnvVariable("BOT_ID", botId)
      .withEnvVariable("SHA", sha)
      .withEnvVariable("REMOTE", remote)
      .withEnvVariable("PULL_REQUEST", if (pullRequest) { "true" } else { "false" })

    let prepared = git
      .withDirectory("/generated", generateSchemas.after)
      .withFile("/run/prepare.sh", currentModule.source.file("refresh-prepare.sh"))
      .withExec(["bash", "/run/prepare.sh"])

    git
      .withDirectory("/repo", prepared.directory("/repo"))
      .withDirectory("/out", prepared.directory("/out"))
      .withFile("/run/publish.sh", currentModule.source.file("refresh-publish.sh"))
      .withSecretVariable("GH_TOKEN", token)
      .withExec(["bash", "/run/publish.sh"])
      .stdout
  }
}
