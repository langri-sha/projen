description: Something is broken.
labels:
  - bug
body:
  - type: textarea
    id: what
    attributes:
      label: What happened?
    validations:
      required: true
  - type: textarea
    id: logs
    attributes:
      label: Logs
      render: shell
",
  ".github/ISSUE_TEMPLATE/02-proposal.md": "---
name: Proposal
about: Suggest a change that needs discussion first.
labels: enhancement
---

## Problem

## Proposed change
",
  ".github/ISSUE_TEMPLATE/config.yml": "# ~~ Generated by projen. To modify, edit .projenrc.js and run "npx projen".

blank_issues_enabled: false
contact_links:
  - name: Questions
    url: https://github.com/acme/acme/discussions
    about: Ask here first.
",
  ".github/PULL_REQUEST_TEMPLATE/release.md": "## Release notes
",
  ".github/pull_request_template.md": "## What does this PR do?

## Recommendations for testing
",
}
