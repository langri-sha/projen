exports[`loadTemplates > feeds GitHubTemplates and synthesizes every file 1`] = `
{
  ".github/ISSUE_TEMPLATE/01-bug-report.yml": "# ~~ Generated by projen. To modify, edit .projenrc.js and run "npx projen".

