{
  "name": "projen-license",
  "version": "0.3.21",
  "description": "A projen component for generating license files using license-o-matic.",
  "bugs": {
    "url": "https://github.com/langri-sha/projen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/langri-sha/projen.git",
    "directory": "packages/projen-license"
  },
  "license": "MIT",
  "author": {
    "name": "Filip Dupanović",
    "email": "filip.dupanovic@gmail.com",
    "url": "https://langri-sha.com",
    "organization": false
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "prepublishOnly": "rm -rf dist; node ../../scripts/inline-dependencies.mjs build 'jsii --silence-warnings JSII6 --fail-on-warnings'",
    "postpublish": "node ../../scripts/inline-dependencies.mjs restore"
  },
  "dependencies": {
    "license-o-matic": "^1.2.0"
  },
  "devDependencies": {
    "@langri-sha/tsconfig": "3.0.0",
    "@langri-sha/vitest": "0.2.3",
    "jsii": "6.0.21",
    "projen": "0.104.1"
  },
  "peerDependencies": {
    "constructs": "^10.5.0",
    "projen": ">=0.86.0 <1.0.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts"
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.ts and run \"pnpm exec projen\".",
  "jsii": {
    "tsconfig": "tsconfig.build.json",
    "validateTsconfig": "minimal"
  }
}
