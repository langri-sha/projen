{
  "name": "projen-prettier",
  "version": "0.4.23",
  "description": "A projen component for configuring Prettier.",
  "bugs": {
    "url": "https://github.com/langri-sha/projen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/langri-sha/projen.git",
    "directory": "packages/projen-prettier"
  },
  "license": "MIT",
  "author": {
    "name": "Filip Dupanović",
    "email": "filip.dupanovic@gmail.com",
    "url": "https://langri-sha.com",
    "organization": false
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "prepublishOnly": "rm -rf dist; node ../../scripts/inline-dependencies.mjs build 'jsii --silence-warnings JSII6'",
    "postpublish": "node ../../scripts/inline-dependencies.mjs restore"
  },
  "dependencies": {
    "serialize-javascript": "7.1.4"
  },
  "devDependencies": {
    "@langri-sha/tsconfig": "3.0.0",
    "@langri-sha/vitest": "0.2.3",
    "@types/serialize-javascript": "5.0.4",
    "jsii": "6.0.20",
    "prettier": "3.9.9",
    "projen": "0.104.1"
  },
  "peerDependencies": {
    "projen": ">=0.86.0 <1.0.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts"
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.ts and run \"pnpm exec projen\".",
  "jsii": {
    "tsconfig": "tsconfig.build.json",
    "validateTsconfig": "minimal"
  }
}
