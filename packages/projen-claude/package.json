{
  "name": "projen-claude",
  "version": "0.2.0",
  "description": "A projen component for authoring Claude Code settings, so the permissions, hooks and environment a repository shares are declared in your projenrc along with everything else.",
  "bugs": {
    "url": "https://github.com/langri-sha/projen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/langri-sha/projen.git",
    "directory": "packages/projen-claude"
  },
  "license": "MIT",
  "author": {
    "name": "Filip Dupanović",
    "email": "filip.dupanovic@gmail.com",
    "url": "https://langri-sha.com",
    "organization": false
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "prepare": "schemastore-to-typescript --no-cache --jsii 'Claude Code Settings' src/settings.ts",
    "prepublishOnly": "rm -rf dist; jsii && test -f dist/settings.d.ts"
  },
  "devDependencies": {
    "@langri-sha/tsconfig": "2.0.0",
    "@langri-sha/vitest": "0.2.3",
    "jsii": "5.9.57",
    "projen": "0.104.1",
    "schemastore-to-typescript": "1.3.0"
  },
  "peerDependencies": {
    "projen": ">=0.86.0 <1.0.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts"
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.ts and run \"pnpm exec projen\".",
  "jsii": {
    "tsconfig": "tsconfig.build.json",
    "validateTsconfig": "minimal"
  }
}
