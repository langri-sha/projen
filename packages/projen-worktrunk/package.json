  "description": "A projen component for authoring Worktrunk project configuration, so the hooks that run across a worktree's lifecycle are declared in your projenrc along with everything else.",
  "bugs": {
    "url": "https://github.com/langri-sha/projen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/langri-sha/projen.git",
    "directory": "packages/projen-worktrunk"
  },
  "license": "MIT",
  "author": {
    "name": "Filip Dupanović",
    "email": "filip.dupanovic@gmail.com",
    "url": "https://langri-sha.com",
    "organization": false
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "prepublishOnly": "rm -rf dist; jsii --silence-warnings JSII6 --silence-warnings JSII5018"
  },
  "devDependencies": {
    "@langri-sha/tsconfig": "3.0.0",
    "@langri-sha/vitest": "0.2.3",
    "jsii": "6.0.20",
    "projen": "0.104.1",
    "smol-toml": "1.9.1"
  },
  "peerDependencies": {
    "constructs": "^10.5.0",
    "projen": ">=0.86.0 <1.0.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts"
  },
