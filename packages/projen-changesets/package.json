{
  "name": "projen-changesets",
  "version": "0.1.3",
  "description": "A projen component for configuring Changesets, so the change files a repository versions and tags with are declared in your projenrc.",
  "bugs": {
    "url": "https://github.com/langri-sha/projen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/langri-sha/projen.git",
    "directory": "packages/projen-changesets"
  },
  "license": "MIT",
  "author": {
    "name": "Filip Dupanović",
    "email": "filip.dupanovic@gmail.com",
    "url": "https://langri-sha.com",
    "organization": false
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "prepare": "schemastore-to-typescript --no-cache Changesets src/config.ts",
    "prepublishOnly": "rm -rf dist; jsii --silence-warnings JSII6 && test -f dist/config.d.ts"
  },
  "devDependencies": {
    "@langri-sha/tsconfig": "3.0.0",
    "@langri-sha/vitest": "0.2.3",
    "jsii": "6.0.20",
    "projen": "0.104.1",
    "schemastore-to-typescript": "1.3.0"
  },
  "peerDependencies": {
    "constructs": "^10.5.0",
    "projen": ">=0.86.0 <1.0.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts"
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.ts and run \"pnpm exec projen\".",
  "jsii": {
    "tsconfig": "tsconfig.build.json",
    "validateTsconfig": "minimal"
  }
}
